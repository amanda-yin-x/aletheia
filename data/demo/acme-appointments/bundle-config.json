        "path": "booking-policy-v2.md",
        "clause_id": "ACME-POL-TZ-001",
        "quote": "A booking or change requires the customer's recorded IANA timezone; do not infer a timezone from a phone number, address, browser, or clinic."
      },
      "loser": {
        "path": "booking-sop-legacy.md",
        "clause_id": "ACME-LEGACY-TZ-001",
        "quote": "If the customer timezone is missing, infer it from the phone prefix or use the clinic timezone."
      },
      "rationale": "The current policy prohibits inferred timezones because they can shift the actual appointment instant."
    }
