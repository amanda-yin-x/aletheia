{
  "schema_version": "0.2",
  "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "tools": [
    {
      "name": "get_customer",
      "mutating": false,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["customer_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_order",
      "mutating": false,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["order_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "request_supervisor_approval",
      "mutating": true,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "amount": {
            "type": "object",
            "properties": {
              "currency": {"type": "string", "const": "USD"},
              "minor_units": {"type": "integer", "minimum": 0, "maximum": 999999999}
            },
            "required": ["currency", "minor_units"],
            "additionalProperties": false
          }
        },
        "required": ["order_id", "amount"],
        "additionalProperties": false
      }
    },
    {
      "name": "issue_refund",
      "mutating": true,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "amount": {
            "type": "object",
            "properties": {
              "currency": {"type": "string", "const": "USD"},
              "minor_units": {"type": "integer", "minimum": 0, "maximum": 999999999}
            },
            "required": ["currency", "minor_units"],
            "additionalProperties": false
          },
          "destination": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["order_id", "item_id", "amount", "destination"],
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_item",
      "mutating": true,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "item_id": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["order_id", "item_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "escalate_case",
      "mutating": true,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "required": ["order_id", "reason"],
        "additionalProperties": false
      }
    },
    {
      "name": "book_callback",
      "mutating": true,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "timezone": {"type": "string", "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)+$", "maxLength": 128}
        },
        "required": ["customer_id", "local_time", "timezone"],
        "additionalProperties": false
      }
    }
  ]
}
