# FastAPI runtime. Local/test mode uses a fixed development identity; production
# fails closed unless every Supabase and origin-secret setting below is present.
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./aletheia.db
MIGRATION_DATABASE_URL=sqlite:///./aletheia.db
WEB_ORIGIN=http://localhost:3000
API_ORIGIN_TOKEN=replace-with-a-long-random-shared-secret
SUPABASE_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_AUDIENCE=authenticated

# Cloudflare/Next.js runtime. These values are read by server code at runtime;
# no database URL, OAuth secret, service-role key, or origin token is public.
API_ORIGIN_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=
SITE_URL=http://localhost:3000
GITHUB_AUTH_ENABLED=false
EMAIL_OTP_ENABLED=false

DEMO_MODE=true
DEMO_INLINE_JOBS=true
DEMO_RESET_SECRET=
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
UPLOAD_MAX_BYTES=2097152
API_MAX_BODY_BYTES=65536
GUEST_MAX_OPERATIONS=6
GUEST_MAX_MUTATIONS=30
GUEST_SESSION_TTL_HOURS=168
GUEST_RETENTION_DAYS=30
GUEST_CLEANUP_INTERVAL_HOURS=24
LOG_LEVEL=INFO

# Optional live-provider seams. Fixture evaluation remains the default and never
# silently falls back from a failed provider request.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
