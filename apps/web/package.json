{
  "name": "@aletheia/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=\"\"",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=staging",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env=\"\"",
    "cf-typegen": "wrangler types --env=\"\" --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.1",
    "lucide-react": "^0.536.0",
    "next": "16.2.12",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "4.118.0"
  }
}
