        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "placement_decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement Decision Id"
        },
        "placement_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement Version"
