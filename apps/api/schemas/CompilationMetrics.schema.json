          "type": "integer"
        },
        "approved_preservation": {
          "maximum": 1,
          "minimum": 0,
          "title": "Approved Preservation",
          "type": "number"
        },
        "blocked_count": {
          "minimum": 0,
          "title": "Blocked Count",
          "type": "integer"
        },
        "explicit_dispositions": {
          "minimum": 0,
          "title": "Explicit Dispositions",
          "type": "integer"
        },
        "high_critical_guard_and_test_placement": {
          "maximum": 1,
          "minimum": 0,
          "title": "High Critical Guard And Test Placement",
          "type": "number"
        },
        "routing_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Routing Coverage",
          "type": "number"
        },
        "severity_weighted_approved_preservation": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity Weighted Approved Preservation",
          "type": "number"
        },
        "unresolved_count": {
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        },
        "unrouted_count": {
          "minimum": 0,
          "title": "Unrouted Count",
          "type": "integer"
        },
        "unsupported_count": {
          "minimum": 0,
          "title": "Unsupported Count",
          "type": "integer"
        },
        "verified_source_anchor_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verified Source Anchor Coverage",
          "type": "number"
        }
      },
      "required": [
        "active_normative_clauses",
        "explicit_dispositions",
        "routing_coverage",
        "verified_source_anchor_coverage",
        "approved_preservation",
        "severity_weighted_approved_preservation",
        "high_critical_guard_and_test_placement",
        "blocked_count",
        "unsupported_count",
        "unrouted_count",
        "unresolved_count"
      ],
      "title": "RoutingMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_always_loaded": {
      "$ref": "#/$defs/ContentSizeMetric"
    },
    "behavioral_fidelity": {
      "const": "not_measured",
      "default": "not_measured",
      "title": "Behavioral Fidelity",
      "type": "string"
    },
    "compiled_kernel": {
      "$ref": "#/$defs/ContentSizeMetric"
    },
    "estimator": {
      "$ref": "#/$defs/MetricsEstimator"
    },
    "expected_per_task_context": {
      "$ref": "#/$defs/ExpectedContextMetric"
    },
    "interpretation": {
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "knowledge": {
      "additionalProperties": {
        "$ref": "#/$defs/ContentSizeMetric"
      },
      "title": "Knowledge",
      "type": "object"
    },
    "machine_enforced": {
      "additionalProperties": {
        "$ref": "#/$defs/ContentSizeMetric"
      },
      "title": "Machine Enforced",
      "type": "object"
    },
    "protected_literals": {
