          "title": "Characters",
          "type": "integer"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "lines": {
          "minimum": 0,
          "title": "Lines",
          "type": "integer"
        },
        "utf8_bytes": {
          "minimum": 0,
          "title": "Utf8 Bytes",
          "type": "integer"
        }
      },
      "required": [
        "lines",
        "characters",
        "utf8_bytes",
        "estimated_tokens"
      ],
      "title": "ContentSizeMetric",
      "type": "object"
    },
    "ExpectedContextMetric": {
      "additionalProperties": false,
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "characters": {
          "minimum": 0,
          "title": "Characters",
          "type": "integer"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "lines": {
          "minimum": 0,
          "title": "Lines",
          "type": "integer"
        },
        "utf8_bytes": {
          "minimum": 0,
          "title": "Utf8 Bytes",
          "type": "integer"
        }
      },
      "required": [
        "lines",
        "characters",
        "utf8_bytes",
        "estimated_tokens",
        "artifact_paths"
      ],
      "title": "ExpectedContextMetric",
      "type": "object"
    },
    "MetricsEstimator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "MetricsEstimator",
      "type": "object"
    },
    "PreservationCheck": {
      "additionalProperties": false,
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "literals": {
          "items": {
            "$ref": "#/$defs/ProtectedLiteral"
          },
          "title": "Literals",
          "type": "array"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/ProtectedLiteral"
          },
          "title": "Missing",
          "type": "array"
        },
        "preserved": {
          "title": "Preserved",
          "type": "boolean"
        },
        "rule_key": {
          "title": "Rule Key",
          "type": "string"
        }
      },
      "required": [
        "rule_key",
        "literals",
        "missing",
        "preserved"
      ],
      "title": "PreservationCheck",
      "type": "object"
    },
    "ProtectedLiteral": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "negation",
            "threshold_or_duration",
            "quoted_literal",
            "tool_name",
            "boundary_or_exception"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ProtectedLiteral",
      "type": "object"
    },
    "RoutingMetrics": {
